    "./scatter/style.css": "./dist/scatter/style.css",
    "./stock": {
      "types": "./dist/stock/index.d.ts",
      "import": "./dist/stock/index.esm.js",
      "require": "./dist/stock/index.js"
    },
    "./stock/style.css": "./dist/stock/style.css",
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-exports.js && rollup -c rollup.config.mjs",
    "build:watch": "rollup -c rollup.config.mjs --watch",
    "build:web": "next build",
    "generate-exports": "node scripts/generate-exports.js",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/classnames": "^2.3.4",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@zjpcy/simple-design": "^1.8.1",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.9.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "react",
    "nextjs",
    "component-library",
    "typescript",
    "rollup",
    "webpack"
  ],
  "license": "MIT",
  "dependencies": {
    "classnames": "^2.5.1",
    "react-syntax-highlighter": "^16.1.1"
  }
}
