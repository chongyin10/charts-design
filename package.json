    "build:watch": "rollup -c rollup.config.mjs --watch",
    "generate-exports": "node scripts/generate-exports.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "=== APP 环境 (组件示例) ===": "",
    "app:dev": "webpack serve --config webpack.app.config.js --mode development",
    "app:build": "webpack --config webpack.app.config.js --mode production",
    "app:serve": "webpack serve --config webpack.app.config.js --mode production",
    "=== WEB 环境 (官网) ===": "",
    "web:dev": "webpack serve --config webpack.web.config.js --mode development",
    "web:build": "webpack --config webpack.web.config.js --mode production",
    "web:serve": "webpack serve --config webpack.web.config.js --mode production",
    "=== COMPONENTS 环境 (发布) ===": "",
    "lib:build": "npm run build"
  },
