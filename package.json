    "./line/style.css": "./dist/line/style.css",
    "./liquid": {
      "types": "./dist/liquid/index.d.ts",
      "import": "./dist/liquid/index.esm.js",
      "require": "./dist/liquid/index.js"
    },
    "./liquid/style.css": "./dist/liquid/style.css",
    "./pie": {
      "types": "./dist/pie/index.d.ts",
      "import": "./dist/pie/index.esm.js",
      "require": "./dist/pie/index.js"
    },
    "./pie/style.css": "./dist/pie/style.css",
    "./radar": {
      "types": "./dist/radar/index.d.ts",
      "import": "./dist/radar/index.esm.js",
      "require": "./dist/radar/index.js"
    },
    "./radar/style.css": "./dist/radar/style.css",
    "./sankey": {
      "types": "./dist/sankey/index.d.ts",
      "import": "./dist/sankey/index.esm.js",
      "require": "./dist/sankey/index.js"
    },
    "./sankey/style.css": "./dist/sankey/style.css",
    "./scatter": {
      "types": "./dist/scatter/index.d.ts",
      "import": "./dist/scatter/index.esm.js",
