{
  "name": "@zjpcy/charts-design",
  "version": "1.0.0",
  "description": "React + Next.js component library with dual build setup (Webpack for dev, Rollup for publish)",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    },
    "./area": {
      "types": "./dist/area/index.d.ts",
      "import": "./dist/area/index.esm.js",
      "require": "./dist/area/index.js"
    },
    "./area/style.css": "./dist/area/style.css",
    "./bar": {
      "types": "./dist/bar/index.d.ts",
      "import": "./dist/bar/index.esm.js",
      "require": "./dist/bar/index.js"
    },
    "./bar/style.css": "./dist/bar/style.css",
    "./bidirectionalbar": {
      "types": "./dist/bidirectionalbar/index.d.ts",
      "import": "./dist/bidirectionalbar/index.esm.js",
      "require": "./dist/bidirectionalbar/index.js"
    },
    "./bidirectionalbar/style.css": "./dist/bidirectionalbar/style.css",
    "./box": {
      "types": "./dist/box/index.d.ts",
      "import": "./dist/box/index.esm.js",
      "require": "./dist/box/index.js"
    },
    "./box/style.css": "./dist/box/style.css",
    "./column": {
      "types": "./dist/column/index.d.ts",
      "import": "./dist/column/index.esm.js",
      "require": "./dist/column/index.js"
    },
    "./column/style.css": "./dist/column/style.css",
    "./dualaxes": {
      "types": "./dist/dualaxes/index.d.ts",
      "import": "./dist/dualaxes/index.esm.js",
      "require": "./dist/dualaxes/index.js"
    },
    "./dualaxes/style.css": "./dist/dualaxes/style.css",
    "./funnel": {
      "types": "./dist/funnel/index.d.ts",
      "import": "./dist/funnel/index.esm.js",
      "require": "./dist/funnel/index.js"
    },
    "./funnel/style.css": "./dist/funnel/style.css",
    "./gauge": {
      "types": "./dist/gauge/index.d.ts",
      "import": "./dist/gauge/index.esm.js",
      "require": "./dist/gauge/index.js"
    },
    "./gauge/style.css": "./dist/gauge/style.css",
    "./heatmap": {
      "types": "./dist/heatmap/index.d.ts",
      "import": "./dist/heatmap/index.esm.js",
      "require": "./dist/heatmap/index.js"
