{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "noEmit": false,
    "outDir": "./dist",
    "declarationDir": "./dist/esm/types",
    "rootDir": "./src"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/lib/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".next",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx"
  ]
}
